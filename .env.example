# OpenAI-compatible text model provider
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Local gateway authentication
GATEWAY_API_KEY=replace-with-a-long-random-value
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ComfyUI
IMAGE_BACKEND=comfy-sdxl
COMFYUI_URL=http://127.0.0.1:8188
CHECKPOINT_NAME=your-sdxl-checkpoint.safetensors
IMAGE_WIDTH=832
IMAGE_HEIGHT=1216
IMAGE_STEPS=24
IMAGE_CFG=6
IMAGE_SAMPLER=dpmpp_2m
IMAGE_SCHEDULER=karras
IMAGE_TIMEOUT_SECONDS=360

# Optional face refinement. Requires ComfyUI Impact Pack and Impact Subpack.
# The conservative defaults target detail recovery without changing the scene's visual style.
FACE_DETAILER_ENABLED=false
FACE_DETAILER_MODEL=bbox/face_yolov8m.pt
FACE_DETAILER_GUIDE_SIZE=576
FACE_DETAILER_MAX_SIZE=768
FACE_DETAILER_STEPS=12
FACE_DETAILER_CFG=5
FACE_DETAILER_DENOISE=0.16
FACE_DETAILER_THRESHOLD=0.35
FACE_DETAILER_DILATION=16
FACE_DETAILER_CROP_FACTOR=2.4
FACE_DETAILER_FEATHER=24

# Story behavior
AUTO_IMAGE_DEFAULT=false
STORY_PROFILE_PATH=examples/story_profile.example.md

# Per-save SQLite long-term memory and local hybrid RAG
MEMORY_ENABLED=true
MEMORY_EXTRACT_ENABLED=true
MEMORY_DATABASE=story_memory.sqlite3
MEMORY_DEFAULT_SAVE_ID=default
MEMORY_TOP_K=8
MEMORY_CONTEXT_MAX_CHARS=6000
MEMORY_BACKUP_DIR=backups

# Structured operational logging. Leave LOG_FILE empty for console-only JSON logs.
LOG_LEVEL=INFO
LOG_FILE=
