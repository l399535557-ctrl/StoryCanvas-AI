# OpenAI-compatible text model provider
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Local gateway authentication
GATEWAY_API_KEY=replace-with-a-long-random-value
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ComfyUI
COMFYUI_URL=http://127.0.0.1:8188
CHECKPOINT_NAME=your-sdxl-checkpoint.safetensors
IMAGE_WIDTH=832
IMAGE_HEIGHT=1216
IMAGE_STEPS=24
IMAGE_CFG=6
IMAGE_SAMPLER=dpmpp_2m
IMAGE_SCHEDULER=karras
IMAGE_TIMEOUT_SECONDS=360

# Story behavior
AUTO_IMAGE_DEFAULT=false
STORY_PROFILE_PATH=examples/story_profile.example.md
